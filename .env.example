# Copy to .env.local. With no Supabase credentials, the app runs in local demo mode.
# Demo mode is for development only. It is rejected when NODE_ENV=production.
DEMO_MODE=false

# Optional Supabase project connection. Add both values to enable Supabase Auth + RLS data mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for administrator invitations and account changes. Server only; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set this to the app's public origin so invitation links always return to the correct site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only to sign local demo sessions. Generate a unique random value before sharing a demo server.
DEMO_SESSION_SECRET=replace-with-a-long-random-development-secret

# Sync newly added equipment to the IAC inventory Google Sheet. Keep credentials server-only.
IAC_EQUIPMENT_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# Paste the private key as a single line with \n where the line breaks belong.
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=
