{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iac-media-team",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "media.imamalicenter.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
